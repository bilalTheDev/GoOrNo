PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/goorno
CLIENT_URL=http://localhost:5173

# Generate long random strings. Do not commit the real values.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Leave blank until Google OAuth credentials exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
